# Copy to backend/.env (gitignored). Server-side only; never expose to the frontend.
SERPAPI_KEY=your_serpapi_key_here
# Optional: "cache" serves only the pre-fetched cache (safest for a live demo).
# EVIDENCE_MODE=cache
# Optional: lets myth cards write a short AI summary (Gemini) of the sources found for a tale.
# GEMINI_API_KEY=your_gemini_key_here
# Optional model override (default gemini-3.5-flash); use any model your key lists for generateContent:
# GEMINI_MODEL=gemini-3.5-flash
# Optional: "cache" stops myth cards from searching or summarising live.
# MYTH_CARD_MODE=cache
